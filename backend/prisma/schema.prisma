generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Student {
  id              Int           @id @default(autoincrement())
  name            String
  school          String
  squadType       SquadType
  tacticRole      TacticRole
  bulletType      BulletType
  armorType       ArmorType
  weaponType      WeaponType
  position        Position
  starGrade       Int           @default(1)
  isLimited       Boolean       @default(false)
  imagePath       String?
  equipmentSlot1  String?
  equipmentSlot2  String?
  equipmentSlot3  String?
  primaryOopart   String?
  secondaryOopart String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  collections     Collection[]
  growthPlans     GrowthPlan[]
  stats           StudentStats?
}

model StudentStats {
  id             Int      @id @default(autoincrement())
  studentId      Int      @unique
  maxHP          Int?
  attackPower    Int?
  defensePower   Int?
  healPower      Int?
  accuracy       Int?
  evasion        Int?
  criticalRate   Int?
  criticalDamage Int?
  stability      Int?
  firingRange    Int?
  ccStrength     Int?
  ccResistance   Int?
  updatedAt      DateTime @updatedAt
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model User {
  id                  Int                   @id @default(autoincrement())
  uid                 Int                   @unique @default(autoincrement())
  username            String                @unique
  password            String
  role                Role                  @default(USER)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  nickname            String?
  isShadowBanned      Boolean               @default(false)
  penaltyStatus       String?               @default("NONE")
  bannedUntil         DateTime?
  lastLoginIp         String?

  collections         Collection[]
  growthPlans         GrowthPlan[]
  inquiries           Inquiry[]
  inquiryResponses    InquiryResponse[]
  notices             Notice[]
  SharedPvpParty      SharedPvpParty[]
  SharedPvpPartyLike  SharedPvpPartyLike[]
  SharedRaidParty     SharedRaidParty[]
  SharedRaidPartyLike SharedRaidPartyLike[]
  reports             Report[]              @relation("Reporter")
  reportedRaids       Report[]              @relation("ReportedUser")
}

model Collection {
  id        Int      @id @default(autoincrement())
  userId    Int
  studentId Int
  starGrade Int      @default(3)
  isOwned   Boolean  @default(true)
  updatedAt DateTime @updatedAt
  details   Json?
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, studentId])
}

model GrowthPlan {
  id                 Int      @id @default(autoincrement())
  userId             Int
  studentId          Int
  currentLevel       Int      @default(1)
  currentEx          Int      @default(1)
  currentBasic       Int      @default(1)
  currentEnh         Int      @default(1)
  currentSub         Int      @default(1)
  currentEquip1      Int      @default(1)
  currentEquip2      Int      @default(1)
  currentEquip3      Int      @default(1)
  targetLevel        Int      @default(85)
  targetEx           Int      @default(5)
  targetBasic        Int      @default(10)
  targetEnh          Int      @default(10)
  targetSub          Int      @default(10)
  targetEquip1       Int      @default(8)
  targetEquip2       Int      @default(8)
  targetEquip3       Int      @default(8)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  currentStar        Int      @default(3)
  targetStar         Int      @default(5)
  currentAbility     Int      @default(0)
  currentWeaponLevel Int      @default(1)
  currentWeaponStar  Int      @default(0)
  targetAbility      Int      @default(0)
  targetWeaponLevel  Int      @default(1)
  targetWeaponStar   Int      @default(0)
  student            Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notice {
  id        Int            @id @default(autoincrement())
  title     String
  content   String
  category  NoticeCategory @default(GENERAL)
  viewCount Int            @default(0)
  authorId  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Inquiry {
  id          Int                 @id @default(autoincrement())
  userId      Int
  category    InquiryCategory
  subCategory InquirySubCategory?
  title       String?
  content     String?
  status      InquiryStatus       @default(PENDING)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  images      InquiryImage[]
  responses   InquiryResponse[]
}

model InquiryImage {
  id        Int      @id @default(autoincrement())
  inquiryId Int
  imageUrl  String
  createdAt DateTime @default(now())
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
}

model InquiryResponse {
  id        Int             @id @default(autoincrement())
  inquiryId Int
  adminId   Int
  content   String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  admin     User            @relation(fields: [adminId], references: [id], onDelete: Cascade)
  inquiry   Inquiry         @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  images    ResponseImage[]
}

model ResponseImage {
  id         Int             @id @default(autoincrement())
  responseId Int
  imageUrl   String
  createdAt  DateTime        @default(now())
  response   InquiryResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
}

model RaidBoss {
  id          String       @id
  name        String
  iconUrl     String
  defenseType String
  category    String       @default("Assault")
  bannerUrl   String?
  RaidSeason  RaidSeason[]
}

model RaidSeason {
  id         Int      @id @default(autoincrement())
  bossId     String
  terrain    String
  difficulty String
  RaidBoss   RaidBoss @relation(fields: [bossId], references: [id], onDelete: Cascade)

  @@unique([bossId, terrain, difficulty])
}

model SharedPvpParty {
  id                 Int                  @id @default(autoincrement())
  shortCode          String?              @unique
  deckType           String
  name               String
  party              Json
  tags               Json
  tactics            String
  imagePath          String?
  youtubeUrls        Json?
  authorId           Int
  likeCount          Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  strategyCode       String?
  reportCount        Int                  @default(0)
  isBlinded          Boolean              @default(false)
  User               User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  SharedPvpPartyLike SharedPvpPartyLike[]
  reports            Report[]
}

model SharedPvpPartyLike {
  id             Int            @id @default(autoincrement())
  userId         Int
  partyId        Int
  deviceFp       String?
  ipAddress      String?
  createdAt      DateTime       @default(now())
  SharedPvpParty SharedPvpParty @relation(fields: [partyId], references: [id], onDelete: Cascade)
  User           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, partyId])
}

model SharedRaidParty {
  id                  Int                   @id @default(autoincrement())
  bossId              String
  terrain             String
  difficulty          String
  name                String
  parties             Json
  tags                Json
  tactics             String
  clearTime           String?
  imagePath           String?
  authorId            Int
  likeCount           Int                   @default(0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  shortCode           String?               @unique
  mode                String                @default("TotalAssault")
  youtubeUrls         Json?
  User                User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  SharedRaidPartyLike SharedRaidPartyLike[]
  reportCount         Int                   @default(0)
  isBlinded           Boolean               @default(false)
  reports             Report[]
}

model SharedRaidPartyLike {
  id              Int             @id @default(autoincrement())
  userId          Int
  partyId         Int
  deviceFp        String?
  ipAddress       String?
  createdAt       DateTime        @default(now())
  SharedRaidParty SharedRaidParty @relation(fields: [partyId], references: [id], onDelete: Cascade)
  User            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, partyId])
}

enum SquadType {
  Main
  Support
}

enum TacticRole {
  DamageDealer
  Tanker
  Healer
  Supporter
  Ride
}

enum BulletType {
  Explosion
  Pierce
  Mystic
  Vibration
  Decomposition
}

enum ArmorType {
  LightArmor
  HeavyArmor
  MysticArmor
  ElasticArmor
  CompositeArmor
}

enum WeaponType {
  AR
  SR
  SG
  SMG
  MG
  HG
  GL
  RL
  MT
  RG
  FT
}

enum Position {
  Front
  Middle
  Back
}

enum Role {
  USER
  ADMIN
}

enum NoticeCategory {
  UPDATE
  EVENT
  GENERAL
}

enum InquiryCategory {
  BUG_REPORT
  RESOURCE_SUPPORT
  SUGGESTION
}

enum InquirySubCategory {
  FULL_BODY
  ITEM
  ETC
}

enum InquiryStatus {
  PENDING
  ANSWERED
}

model Report {
  id                 Int              @id @default(autoincrement())
  reporterId         Int
  reportedRaidId     Int?
  reportedPvpPartyId Int?
  reportedUserId     Int
  reason             String
  description        String?
  status             String           @default("PENDING") // PENDING, REVIEWED, RESOLVED
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  reporter           User             @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser       User             @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reportedRaid       SharedRaidParty? @relation(fields: [reportedRaidId], references: [id], onDelete: Cascade)
  reportedPvpParty   SharedPvpParty?  @relation(fields: [reportedPvpPartyId], references: [id], onDelete: Cascade)
}

model BannedIP {
  id              Int      @id @default(autoincrement())
  ipAddress       String   @unique
  reason          String?
  createdAt       DateTime @default(now())
  bannedByAdminId Int?
}
