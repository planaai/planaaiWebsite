# ==============================================================================
# Plana.AI Project Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ------------------------------------------------------------------------------
# Frontend Builds (Next.js / Vite / Cloudflare Pages / Vercel)
# ------------------------------------------------------------------------------
.next/
.open-next/
.wrangler/
.vercel/
out/
build/
dist/
dist-ssr/
next-env.d.ts
*.tsbuildinfo

# ------------------------------------------------------------------------------
# Backend & Live Server Data (Protected)
# ------------------------------------------------------------------------------
/backend/
/backend/uploads/
/backend/data/
/backend/generated/prisma
/backend/prisma/*.db
/backend/prisma/*.db-journal
/backend/prisma/*.db-shm
/backend/prisma/*.db-wal
backend_data_backup/
databackup/
uploads/
*.sql
*.dump

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
*.local
!.env.example
!ocr-engine/.env.example

# ------------------------------------------------------------------------------
# Python & Machine Learning
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/

# OCR Engine Models & Golden Set Images (Heavy binary assets)
ocr-engine/models/*.onnx
ocr-engine/tests/golden/*
!ocr-engine/tests/golden/README.md

# ------------------------------------------------------------------------------
# Security, Certificates & Keys
# ------------------------------------------------------------------------------
*.pem
*.key
*.cert
SECURITY_HANDOVER.md
ip.txt

# ------------------------------------------------------------------------------
# Logs & Testing Output
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
lerna-debug.log*
coverage/
lint-results.json
lint-results.txt
.eslintcache

# ------------------------------------------------------------------------------
# Operating System & Editors
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
~$*.xlsx

# Editors & IDEs
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ------------------------------------------------------------------------------
# Compressed Archives
# ------------------------------------------------------------------------------
*.tar.gz
*.zip
*.rar
*.7z

# ------------------------------------------------------------------------------
# AI Agent, Scratch & Knowledge Vault
# ------------------------------------------------------------------------------
docs-vault/
.agents/
.agent/
.claude/
.cursor/
.agentignore
CLAUDE.local.md
scratch/

# ------------------------------------------------------------------------------
# Sensitive Internal Tools & Repositories
# ------------------------------------------------------------------------------
docs/
tools/
missing_skill_icons.md
QA_PROCESS.md
frontend/README.md
client/README.md
deploy/
client-pvp/
gacha_changes/
/ico/
cloudflare-router/
client/AGENTS.md
client/CLAUDE.md
start_servers.bat
stop_servers.bat
licenses.txt
